@model IndorMvcApp.ViewModels.CleaningDetailsViewModel
@{
    ViewData["Title"] = L.Catalog(Model.PageTitle) + " - INDOR";
    ViewData["WizardTitle"] = L.Catalog(Model.PageTitle);
    ViewData["WizardStep"] = 1;
    ViewData["WizardTotalSteps"] = 3;
    ViewData["WizardBackUrl"] = Url.Action("CleaningService", "Cleaning", new { id = Model.MovingSetupServicioId });
    var addressHint = L["Enter a complete address with city and state (e.g. 123 Main St, Charlotte, NC)."].ToString();
    var addressEmptyMessage = L["Please enter the property address."].ToString();
}

<div class="cl-wizard-heading">
    <h2>@L["Tell us about your cleaning request"]</h2>
    <p>@L["Help INDOR send the right cleaning crew for your move."]</p>
</div>

<div asp-validation-summary="ModelOnly" class="validation-summary"></div>

<form asp-action="CleaningDetails" method="post" id="cleaningDetailsForm" class="iw-step-form" novalidate>
    <input type="hidden" asp-for="SolicitudId" />
    <input type="hidden" asp-for="MovingSetupServicioId" />
    <input type="hidden" asp-for="NombreServicio" />
    <input type="hidden" asp-for="TipoLimpieza" id="TipoLimpieza" />
    <input type="hidden" asp-for="TipoPropiedad" id="TipoPropiedad" />
    <input type="hidden" asp-for="NumeroHabitaciones" id="NumeroHabitaciones" />
    <input type="hidden" asp-for="NumeroBanos" id="NumeroBanos" />
    <input type="hidden" asp-for="CondicionActual" id="CondicionActual" />
    <input type="hidden" asp-for="VentanaHorario" id="VentanaHorario" />

    <div class="field-card" data-svc-required="DireccionPropiedad">
        <span class="field-label">@L["Property"]</span>
        <div class="input-wrap">
            <i class="fas fa-location-dot"></i>
            <input asp-for="DireccionPropiedad" id="DireccionPropiedad" class="address-input"
                   placeholder="@L["123 Main St, Charlotte, NC 28202"]" readonly
                   data-address-autocomplete autocomplete="off" />
        </div>
        <button type="button" class="address-edit-btn" id="editAddressBtn" aria-controls="DireccionPropiedad">@L["Edit"]</button>
        <p class="field-hint">@addressHint</p>
    </div>

    <div class="field-card" data-svc-required="TipoLimpieza">
        <span class="field-label">@L["Cleaning type"]</span>
        <div class="tile-grid" data-target="TipoLimpieza">
            <button type="button" class="type-card" data-value="MoveIn"><span class="check"><i class="fas fa-check"></i></span><i class="fas fa-house-circle-check"></i>@L["Move-In Cleaning"]</button>
            <button type="button" class="type-card" data-value="MoveOut"><span class="check"><i class="fas fa-check"></i></span><i class="fas fa-house-circle-xmark"></i>@L["Move-Out Cleaning"]</button>
            <button type="button" class="type-card" data-value="Both"><span class="check"><i class="fas fa-check"></i></span><i class="fas fa-arrows-rotate"></i>@L["Both"]</button>
        </div>
    </div>

    <div class="field-card" data-svc-required="TipoPropiedad">
        <span class="field-label">@L["Property type"]</span>
        <div class="segment-row" data-target="TipoPropiedad">
            <button type="button" class="segment-btn" data-value="House"><i class="fas fa-house"></i> @L["House"]</button>
            <button type="button" class="segment-btn" data-value="Apartment"><i class="fas fa-building"></i> @L["Apartment"]</button>
            <button type="button" class="segment-btn" data-value="Condo"><i class="fas fa-city"></i> @L["Condo"]</button>
            <button type="button" class="segment-btn" data-value="Townhome"><i class="fas fa-house-chimney"></i> @L["Townhome"]</button>
        </div>
    </div>

    <div class="field-card" data-svc-required="NumeroHabitaciones">
        <span class="field-label">@L["Bedrooms"]</span>
        <div class="segment-row" data-target="NumeroHabitaciones">
            <button type="button" class="segment-btn" data-value="One">@L["1 bed"]</button>
            <button type="button" class="segment-btn" data-value="Two">@L["2 bed"]</button>
            <button type="button" class="segment-btn" data-value="Three">@L["3 bed"]</button>
            <button type="button" class="segment-btn" data-value="FourPlus">@L["4+ bed"]</button>
        </div>
    </div>

    <div class="field-card" data-svc-required="NumeroBanos">
        <span class="field-label">@L["Bathrooms"]</span>
        <div class="segment-row" data-target="NumeroBanos">
            <button type="button" class="segment-btn" data-value="One">@L["1 bath"]</button>
            <button type="button" class="segment-btn" data-value="Two">@L["2 bath"]</button>
            <button type="button" class="segment-btn" data-value="ThreePlus">@L["3+ bath"]</button>
        </div>
    </div>

    <div class="field-card" data-svc-required="CondicionActual">
        <span class="field-label">@L["Current condition"]</span>
        <div class="tile-grid" data-target="CondicionActual">
            <button type="button" class="type-card" data-value="Empty"><span class="check"><i class="fas fa-check"></i></span><i class="fas fa-box-open"></i>@L["Empty property"]</button>
            <button type="button" class="type-card" data-value="LightlyFurnished"><span class="check"><i class="fas fa-check"></i></span><i class="fas fa-couch"></i>@L["Lightly furnished"]</button>
            <button type="button" class="type-card" data-value="Occupied"><span class="check"><i class="fas fa-check"></i></span><i class="fas fa-users"></i>@L["Occupied"]</button>
        </div>
    </div>

    <div class="field-card" data-svc-optional>
        <span class="field-label">@L["Date"]</span>
        <div class="input-wrap">
            <i class="fas fa-calendar"></i>
            <input asp-for="FechaServicio" type="date" />
        </div>
    </div>

    <div class="field-card" data-svc-required="VentanaHorario">
        <span class="field-label">@L["Preferred arrival time"]</span>
        <div class="input-wrap">
            <i class="fas fa-clock"></i>
            <select id="VentanaHorarioSelect">
                <option value="">@L["Select a time"]</option>
                <option value="Morning">@L["10:00 AM – 12:00 PM"]</option>
                <option value="MidMorning">@L["12:00 PM – 2:00 PM"]</option>
                <option value="Afternoon">@L["2:00 PM – 4:00 PM"]</option>
                <option value="Evening">@L["4:00 PM – 6:00 PM"]</option>
            </select>
        </div>
    </div>

    <div class="sticky-footer">
        <button type="submit" class="btn-primary">@L["Continue"] <i class="fas fa-chevron-right"></i></button>
        <button type="submit" name="action" value="skip" class="btn-outline" formnovalidate>@L["Skip date for now"]</button>
    </div>
</form>

@section Scripts {
<script>
    (function () {
        function initCards(containerSelector, hiddenId, initial, cardClass) {
            const hidden = document.getElementById(hiddenId);
            const container = document.querySelector(containerSelector);
            if (!container || !hidden) return;
            const buttons = container.querySelectorAll('.' + cardClass);
            const seed = (initial && String(initial).trim()) || (hidden.value || '').trim();
            function setActive(value) {
                hidden.value = value || '';
                buttons.forEach(b => b.classList.toggle('active', !!value && b.dataset.value === value));
            }
            buttons.forEach(btn => btn.addEventListener('click', () => setActive(btn.dataset.value)));
            setActive(seed);
        }

        function initSegments(containerSelector, hiddenId, initial) {
            const hidden = document.getElementById(hiddenId);
            const container = document.querySelector(containerSelector);
            if (!container || !hidden) return;
            const buttons = container.querySelectorAll('.segment-btn');
            const seed = (initial && String(initial).trim()) || (hidden.value || '').trim();
            function setActive(value) {
                hidden.value = value || '';
                buttons.forEach(b => b.classList.toggle('active', !!value && b.dataset.value === value));
            }
            buttons.forEach(btn => btn.addEventListener('click', () => setActive(btn.dataset.value)));
            setActive(seed);
        }

        initCards('[data-target="TipoLimpieza"]', 'TipoLimpieza', '@Model.TipoLimpieza', 'type-card');
        initSegments('[data-target="TipoPropiedad"]', 'TipoPropiedad', '@Model.TipoPropiedad');
        initSegments('[data-target="NumeroHabitaciones"]', 'NumeroHabitaciones', '@Model.NumeroHabitaciones');
        initSegments('[data-target="NumeroBanos"]', 'NumeroBanos', '@Model.NumeroBanos');
        initCards('[data-target="CondicionActual"]', 'CondicionActual', '@Model.CondicionActual', 'type-card');

        const timeHidden = document.getElementById('VentanaHorario');
        const timeSelect = document.getElementById('VentanaHorarioSelect');
        if (timeHidden && timeSelect) {
            timeSelect.value = timeHidden.value || '';
            timeSelect.addEventListener('change', () => { timeHidden.value = timeSelect.value; });
        }

        const addressInput = document.getElementById('DireccionPropiedad');
        const editAddressBtn = document.getElementById('editAddressBtn');

        function enableAddressEdit() {
            if (!addressInput) return;
            addressInput.removeAttribute('readonly');
            addressInput.focus();
            try {
                addressInput.setSelectionRange(0, addressInput.value.length);
            } catch (_) { }
        }

        editAddressBtn?.addEventListener('click', enableAddressEdit);
        addressInput?.addEventListener('focus', function () {
            addressInput.removeAttribute('readonly');
        });

        const addressMessage = @Json.Serialize(addressHint);
        const addressEmptyMessage = @Json.Serialize(addressEmptyMessage);

        function isValidStreetAddress(value) {
            const address = String(value || '').trim();
            if (address.length < 5) return false;
            if (!/\p{L}/u.test(address)) return false;
            if (/^[\d\s.,#-]+$/.test(address)) return false;
            const tokens = address.split(/\s+/).filter(Boolean);
            const hasDigit = /\d/.test(address);
            const wordParts = tokens.filter(part => /\p{L}/u.test(part)).length;
            if (!hasDigit || wordParts < 2) return false;
            const hasComma = address.includes(',');
            const hasZip = tokens.slice(1).some(t => /^\d{5}(-\d{4})?$/.test(t.replace(/[.,]+$/, '')));
            return hasComma || hasZip;
        }

        function showInline(card, message) {
            if (!card) return;
            card.classList.add('is-invalid');
            const existing = card.querySelector('[data-svc-error="true"]');
            if (existing) {
                existing.textContent = message;
                return;
            }
            const msg = document.createElement('div');
            msg.className = 'field-inline-error';
            msg.setAttribute('data-svc-error', 'true');
            msg.setAttribute('role', 'alert');
            msg.textContent = message;
            card.appendChild(msg);
        }

        document.getElementById('cleaningDetailsForm')?.addEventListener('submit', function (e) {
            if (e.submitter && (e.submitter.value === 'skip' || e.submitter.getAttribute('formnovalidate') != null)) {
                return;
            }

            let firstInvalid = null;
            const input = document.getElementById('DireccionPropiedad');
            const card = input?.closest('.field-card');
            if (input && card) {
                const value = String(input.value || '').trim();
                if (!value) {
                    showInline(card, addressEmptyMessage);
                    if (!firstInvalid) firstInvalid = card;
                } else if (!isValidStreetAddress(value)) {
                    showInline(card, addressMessage);
                    if (!firstInvalid) firstInvalid = card;
                }
            }

            if (firstInvalid) {
                e.preventDefault();
                e.stopPropagation();
                enableAddressEdit();
                firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }, true);
    })();
</script>
@await Html.PartialAsync("_AddressAutocompleteScripts")
}
