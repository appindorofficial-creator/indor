@model IndorMvcApp.ViewModels.RealtorPropertyFileDocumentViewModel
@{
    Layout = "_RealtorLayout";
    ViewData["Title"] = Model.FileName;
    ViewBag.NavActive = "files";
    var staticUrl = Model.FileUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase)
        ? Model.FileUrl
        : Url.Content("~" + Model.FileUrl);
    var streamUrl = string.IsNullOrWhiteSpace(Model.DocumentFileUrl)
        ? staticUrl
        : Model.DocumentFileUrl;
    var pdfViewerUrl = streamUrl;
    var renderAllPages = Model.PreferNativeEmbed;
}
<div class="rl-dash-shell rl-insp-report-view-page">
    <header class="rl-listing-detail-head">
        <a href="@Model.BackUrl" class="rl-listing-detail-back" aria-label="@L["Back to property file"]">
            <i class="fas fa-chevron-left"></i>
        </a>
        <div class="rl-listing-detail-head-copy">
            <h1>@Model.FileName</h1>
            <p id="rlReportPageLabel">
                @(renderAllPages ? L["Full document"] : L["Property file document"])
            </p>
        </div>
    </header>

    @if (Model.IsImage)
    {
        <div class="rl-file-doc-image-wrap">
            <img src="@streamUrl" alt="@Model.FileName" class="rl-file-doc-image" />
        </div>
    }
    else if (Model.IsVideo)
    {
        <div class="rl-file-doc-image-wrap">
            <video class="rl-file-doc-image" controls playsinline preload="metadata" src="@streamUrl">
                @L["Your browser cannot play this video."]
            </video>
        </div>
        <p class="rl-file-doc-fallback">
            <a href="@Model.BackUrl">@L["Back to property file"]</a>
        </p>
    }
    else if (Model.IsPdf)
    {
        @* PDF.js — iOS/WebView shows a blank screen when PDFs use target=_blank / raw navigation. *@
        <div class="rl-insp-report-toolbar" id="rlReportToolbar" hidden>
            <button type="button" class="rl-insp-report-nav-btn" id="rlReportPrev" aria-label="@L["Previous page"]">
                <i class="fas fa-chevron-left"></i>
            </button>
            <span class="rl-insp-report-page-indicator" id="rlReportPageIndicator"></span>
            <button type="button" class="rl-insp-report-nav-btn" id="rlReportNext" aria-label="@L["Next page"]">
                <i class="fas fa-chevron-right"></i>
            </button>
        </div>

        <div class="rl-insp-report-viewer"
             id="rlReportViewer"
             data-pdf-url="@pdfViewerUrl"
             data-start-page="1">
            <div class="rl-insp-report-loading" id="rlReportLoading">
                <i class="fas fa-spinner fa-spin"></i>
                <span>@L["Loading report page…"]</span>
            </div>
            <canvas id="rlReportCanvas" class="rl-insp-report-canvas" hidden></canvas>
            <p class="rl-insp-report-error" id="rlReportError" hidden>@L["Could not open this report page. Try again."]</p>
        </div>

        <div class="rl-insp-report-open-actions">
            @if (renderAllPages)
            {
                <a asp-action="OpenDocument"
                   asp-route-id="@Model.PropertyFileId"
                   asp-route-itemId="@Model.ItemId"
                   class="rl-insp-report-open-native">
                    <i class="fas fa-eye"></i> @L["Try page preview"]
                </a>
            }
            else
            {
                <a asp-action="OpenDocument"
                   asp-route-id="@Model.PropertyFileId"
                   asp-route-itemId="@Model.ItemId"
                   asp-route-mode="full"
                   class="rl-insp-report-open-native">
                    <i class="fas fa-up-right-from-square"></i> @L["Open full PDF"]
                </a>
            }
            <a href="@Model.BackUrl" class="rl-insp-report-open-native rl-insp-report-open-native--secondary">
                <i class="fas fa-chevron-left"></i> @L["Back to property file"]
            </a>
        </div>
    }
    else
    {
        <div class="rl-info-box rl-info-box--muted">
            <i class="fas fa-circle-info"></i>
            <p>@L["This file type cannot be previewed here. Open it with your device viewer."]</p>
        </div>
        <p class="rl-file-doc-fallback">
            <a href="@Model.BackUrl" class="ob-btn ob-btn-primary">@L["Back to property file"]</a>
        </p>
    }
</div>

@section Scripts {
@if (Model.IsPdf)
{
<script src="~/lib/pdfjs/pdf.min.js" asp-append-version="true"></script>
<script src="~/js/realtor-pdf-viewer.js" asp-append-version="true"></script>
<script>
    IndorRealtorPdfViewer.boot({
        pdfUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pdfViewerUrl)),
        workerSrc: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Content("~/lib/pdfjs/pdf.worker.min.js"))),
        startPage: 1,
        renderAll: @(renderAllPages ? "true" : "false"),
        pageLabelTemplate: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Page {0}"].ToString())),
        ofTemplate: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Page {0} of {1}"].ToString()))
    });
</script>
}
}
