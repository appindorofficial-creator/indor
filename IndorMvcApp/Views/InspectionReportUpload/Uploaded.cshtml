@model IndorMvcApp.ViewModels.InspectionReportUploadedViewModel
@using IndorMvcApp.Localization
@inject IIndorLocalizer L
@{
    string Tx(string key, string spanish)
    {
        if (!L.IsSpanish)
        {
            return key;
        }

        var translated = L[key];
        return string.IsNullOrEmpty(translated) || translated == key ? spanish : translated;
    }

    ViewData["Title"] = Tx("Report Uploaded", "Informe subido");
    Layout = null;
}
<!DOCTYPE html>
<html lang="@UiCulture.HtmlLang(L.CurrentCulture)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] - INDOR</title>
    @await Html.PartialAsync("_NavigationLoadingHead")
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/hvac-setup.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/inspection-report-upload.css" asp-append-version="true" />
</head>
<body>
<div class="hvac-page">
    <div class="hvac-top">
        <a asp-controller="Home" asp-action="Index" class="hvac-back" aria-label="@L["Back"]"><i class="fas fa-chevron-left"></i></a>
        <div class="hvac-title">@Tx("Report Uploaded", "Informe subido")</div>
        <div style="width:40px;"></div>
    </div>

    <div class="hvac-content">
        <div class="ir-success-hero">
            <div class="icon-wrap"><i class="fas fa-check"></i></div>
            <strong>@Tx("Your inspection report has been uploaded.", "Tu informe de inspección se ha subido.")</strong>
            <p style="margin:8px 0 0;font-size:0.8125rem;color:#64748B;">@Tx("Your home records are now up to date.", "Los registros de tu hogar ya están al día.")</p>
        </div>

        <h2 class="hvac-section-title">@Tx("What happens next", "Qué sigue")</h2>
        <div class="hvac-next-list ir-next-list">
            <div class="hvac-next-item">
                <span class="hvac-next-icon"><i class="far fa-file-lines"></i></span>
                <span class="hvac-next-body">
                    <strong>@Tx("Saved to Documents", "Guardado en Documentos")</strong>
                    <span>@Tx("Your report is securely stored.", "Tu informe está almacenado de forma segura.")</span>
                </span>
            </div>
            <div class="hvac-next-item">
                <span class="hvac-next-icon"><i class="fas fa-house"></i></span>
                <span class="hvac-next-body">
                    <strong>@Tx("Available from Home", "Disponible desde Inicio")</strong>
                    <span>@Tx("Access it anytime from your home.", "Accede a él cuando quieras desde tu hogar.")</span>
                </span>
            </div>
            <div class="hvac-next-item">
                <span class="hvac-next-icon"><i class="far fa-bell"></i></span>
                <span class="hvac-next-body">
                    <strong>@Tx("Ready for future reminders", "Listo para recordatorios futuros")</strong>
                    <span>@Tx("We'll use it to keep you on track.", "Lo usaremos para ayudarte a mantenerte al día.")</span>
                </span>
            </div>
        </div>

        <h2 class="hvac-section-title">@Tx("Uploaded document", "Documento subido")</h2>
        <div class="ir-doc-preview">
            <div class="pdf-badge">@Model.FileTypeLabel</div>
            <div>
                <strong>@Model.Title</strong>
                <span>@Model.UploadedDateLabel</span>
            </div>
        </div>

        <a asp-controller="Home" asp-action="Index" class="hvac-save-btn" style="text-align:center;text-decoration:none;line-height:1.2;">@Tx("Done", "Listo")</a>
    </div>

    @await Html.PartialAsync("_AppBottomNav", "home")
</div>
</body>
</html>
