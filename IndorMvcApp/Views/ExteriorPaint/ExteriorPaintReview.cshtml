@model IndorMvcApp.ViewModels.ExteriorPaintReviewViewModel
@{
    ViewData["Title"] = L.Catalog(Model.PageTitle) + " - INDOR";
    ViewData["WizardTitle"] = L.Catalog(Model.PageTitle);
    ViewData["WizardBackUrl"] = Url.Action("Index", "Home");
    ViewData["WizardStep"] = 1;
    ViewData["WizardTotalSteps"] = 4;
}

<div class="ep-title-row">
    <div class="left">
        <h1 class="page-heading" style="margin-bottom:4px;font-size:1.15rem;">@L.Catalog(Model.LandingTitulo)</h1>
        @if (!string.IsNullOrWhiteSpace(Model.LandingTagline))
        {
            <div class="tagline">@L.Catalog(Model.LandingTagline)</div>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.ImagenUrl))
    {
        <img src="@Url.Content("~" + Model.ImagenUrl)" alt="@L.Catalog(Model.LandingTitulo)" class="ep-thumb" />
    }
</div>

@if (!string.IsNullOrWhiteSpace(Model.InfoBoxTexto))
{
    <div class="info-box-blue">
        <i class="fas fa-circle-info"></i>
        <span>@L.Catalog(Model.InfoBoxTexto)</span>
    </div>
}

<form id="ep-review-form" asp-action="ExteriorPaintReview" method="post" novalidate>
    <div asp-validation-summary="All" class="validation-summary"></div>
    <input type="hidden" asp-for="HomeCarePriorityId" />
    <input type="hidden" asp-for="SolicitudId" />
    <input type="hidden" asp-for="UltimaPintura" id="UltimaPintura" />
    <input type="hidden" asp-for="TipoSuperficie" id="TipoSuperficie" />
    <input type="hidden" asp-for="MantenerMismoColor" id="MantenerMismoColor" />

    <div class="field-card" data-svc-required="UltimaPintura">
        <div class="question-num">1</div>
        <div class="field-head"><i class="fas fa-calendar"></i><span>@L["When was the exterior last painted?"]</span></div>
        <div class="paint-age-grid">
            <button type="button" class="paint-age-btn" data-age="LessThan3Years"><i class="fas fa-calendar-check"></i><span>@L["Less than 3 years"]</span></button>
            <button type="button" class="paint-age-btn" data-age="ThreeToFiveYears"><i class="fas fa-calendar"></i><span>@L["3–5 years"]</span></button>
            <button type="button" class="paint-age-btn" data-age="FiveToSevenYears"><i class="fas fa-calendar"></i><span>@L["5–7 years"]</span></button>
            <button type="button" class="paint-age-btn" data-age="SevenPlusYears"><i class="fas fa-calendar-plus"></i><span>@L["7+ years"]</span></button>
            <button type="button" class="paint-age-btn" data-age="DontKnow"><i class="fas fa-circle-question"></i><span>@L["I don't know"]</span></button>
        </div>
    </div>

    <div class="field-card" data-svc-required="TipoSuperficie">
        <div class="question-num">2</div>
        <div class="field-head"><i class="fas fa-house"></i><span>@L["What exterior surface do you have?"]</span></div>
        <div class="surface-grid">
            <button type="button" class="surface-card" data-surface="WoodSiding"><i class="fas fa-grip-lines-vertical main"></i><span class="label">@L["Wood siding"]</span></button>
            <button type="button" class="surface-card" data-surface="FiberCement"><i class="fas fa-grip-lines main"></i><span class="label">@L["Fiber cement / Hardie"]</span></button>
            <button type="button" class="surface-card" data-surface="Stucco"><i class="fas fa-braille main"></i><span class="label">@L["Stucco"]</span></button>
            <button type="button" class="surface-card" data-surface="Brick"><i class="fas fa-table-cells main"></i><span class="label">@L["Brick"]</span><span class="sub">@L["(painted or unpainted)"]</span></button>
            <button type="button" class="surface-card" data-surface="VinylSiding"><i class="fas fa-layer-group main"></i><span class="label">@L["Vinyl siding"]</span></button>
            <button type="button" class="surface-card" data-surface="MetalAluminum"><i class="fas fa-bars main"></i><span class="label">@L["Metal / aluminum"]</span></button>
        </div>
    </div>

    <div class="field-card" data-svc-required="MantenerMismoColor">
        <div class="question-num">3</div>
        <div class="field-head"><i class="fas fa-palette"></i><span>@L["Would you like to keep the same color?"]</span></div>
        <div class="color-grid-2">
            <button type="button" class="color-card" data-color="Yes"><i class="fas fa-paint-roller main"></i><span class="label">@L["Yes"]</span></button>
            <button type="button" class="color-card" data-color="No"><i class="fas fa-paintbrush main"></i><span class="label">@L["No"]</span></button>
        </div>
    </div>

    <button type="submit" name="action" value="continue" class="btn-primary">
        @L.Catalog(Model.CtaTexto) <i class="fas fa-chevron-right"></i>
    </button>
</form>

@section Scripts {
<script>
    (function () {
        function bindSingle(groupSelector, attr, input, initial) {
            if (!input) return;
            document.querySelectorAll(groupSelector).forEach(function (btn) {
                btn.addEventListener('click', function () {
                    document.querySelectorAll(groupSelector).forEach(function (b) { b.classList.remove('active'); });
                    btn.classList.add('active');
                    input.value = btn.getAttribute(attr) || '';
                });
            });

            var seed = (initial && String(initial).trim()) || (input.value && String(input.value).trim()) || '';
            input.value = seed;
            document.querySelectorAll(groupSelector).forEach(function (btn) {
                btn.classList.toggle('active', !!seed && btn.getAttribute(attr) === seed);
            });
        }

        bindSingle('[data-age]', 'data-age', document.getElementById('UltimaPintura'), '@Model.UltimaPintura');
        bindSingle('[data-surface]', 'data-surface', document.getElementById('TipoSuperficie'), '@Model.TipoSuperficie');
        bindSingle('[data-color]', 'data-color', document.getElementById('MantenerMismoColor'), '@Model.MantenerMismoColor');
    })();
</script>
}
