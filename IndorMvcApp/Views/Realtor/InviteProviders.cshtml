@model IndorMvcApp.ViewModels.RealtorInviteProvidersViewModel
@{
    ViewData["Title"] = L["Invite Providers"];
    Layout = "_RealtorLayout";
    ViewBag.NavActive = "quotes";
    var formError = TempData["InviteProvidersError"] as string;
    var selectableCount = Model.Providers.Count(p => !p.AlreadyInvited);
}

<div class="rl-dash-shell">
    @await Html.PartialAsync("_RealtorTopbar", Model)

    <div class="rl-page-header rl-page-header--stack">
        <a asp-controller="Realtor" asp-action="QuoteDetail" asp-route-id="@Model.QuoteId" class="rl-back-link">
            <i class="fas fa-chevron-left"></i> @L["Back to request"]
        </a>
        <h1 class="rl-page-title">@L["Invite Providers"]</h1>
        <p class="rl-section-caption">@Model.Address · @UiDisplayLocalization.Localize(L, Model.ServiceType)</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(formError))
    {
        <div class="rl-error-banner" role="alert">
            <i class="fas fa-circle-exclamation"></i>
            <div>@formError</div>
        </div>
    }

    <form method="get" asp-action="InviteProviders" asp-route-id="@Model.QuoteId" class="rl-invite-form">
        <div class="rl-search-bar rl-search-bar--inline">
            <i class="fas fa-magnifying-glass"></i>
            <input type="search" name="q" value="@Model.SearchQuery" placeholder="@L["Search company or service"]" />
        </div>
    </form>

    <form id="inviteProvidersForm" asp-action="InviteProviders" asp-route-id="@Model.QuoteId" method="post" class="rl-invite-form">
        @Html.AntiForgeryToken()

        <div class="rl-info-box rl-info-box--muted">
            <i class="fas fa-circle-info"></i>
            <p>@L["Recommended to send to 2–3 providers."]</p>
        </div>

        @if (Model.AlreadyInvitedCount > 0)
        {
            <p class="rl-section-caption">@L.T("{0} already invited", Model.AlreadyInvitedCount)</p>
        }

        <h2 class="rl-invite-section-title">@L["Select Providers"]</h2>
        @if (Model.Providers.Count == 0)
        {
            <div class="rl-info-box rl-info-box--muted">
                <i class="fas fa-circle-info"></i>
                <p>@L["No providers match these filters yet. Try a different search."]</p>
            </div>
        }
        else
        {
            @foreach (var provider in Model.Providers)
            {
                <label class="rl-provider-card @(provider.Selected || provider.AlreadyInvited ? "is-selected" : "")">
                    @if (provider.AlreadyInvited)
                    {
                        <input type="checkbox" value="@provider.Id" checked disabled />
                    }
                    else
                    {
                        <input type="checkbox" name="providerIds" value="@provider.Id" @(provider.Selected ? "checked" : null) />
                    }
                    <span class="rl-provider-logo"><i class="fas fa-building"></i></span>
                    <span class="rl-provider-body">
                        <strong>@provider.CompanyName</strong>
                        @if (!string.IsNullOrWhiteSpace(provider.BadgeLabel))
                        {
                            <em>@UiDisplayLocalization.Localize(L, provider.BadgeLabel)</em>
                        }
                        @if (provider.AlreadyInvited)
                        {
                            <small>@L["Already invited"]</small>
                        }
                        else if (!string.IsNullOrWhiteSpace(provider.Categories))
                        {
                            <small>@UiDisplayLocalization.Localize(L, provider.Categories)</small>
                        }
                    </span>
                </label>
            }
        }
    </form>

    <div class="rl-invite-actions">
        <a asp-action="QuoteDetail" asp-route-id="@Model.QuoteId" class="rl-invite-cancel">@L["Back"]</a>
        <button type="submit"
                form="inviteProvidersForm"
                class="ob-btn ob-btn-primary"
                @(selectableCount == 0 ? "disabled" : null)>
            @L["Send Invites"]
        </button>
    </div>
</div>
