@model IndorMvcApp.ViewModels.UtilitiesSetupAddressViewModel
@{
    ViewData["Title"] = L.Catalog(Model.PageTitle) + " - INDOR";
    ViewData["WizardTitle"] = L.Catalog(Model.PageTitle);
    ViewData["WizardBackUrl"] = Url.Action("Index", "Home");
    ViewData["WizardStep"] = 1;
    ViewData["WizardTotalSteps"] = 4;
    var fechaMin = DateTime.Today.ToString("yyyy-MM-dd");
    var fechaValue = Model.FechaServicio?.ToString("yyyy-MM-dd") ?? string.Empty;
}


<h2 class="page-heading" style="font-size:1.15rem;">@L.Catalog(Model.PageTitle)</h2>
    <p class="page-lead" style="margin-top:-8px;">@L.Catalog(Model.Subtitulo)</p>

    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <form asp-action="UtilitiesSetupAddress" method="post" novalidate>
        <input type="hidden" asp-for="SolicitudId" />
        <input type="hidden" asp-for="MovingSetupServicioId" />
        <input type="hidden" asp-for="ServiciosConectar" id="ServiciosConectar" />
        <input type="hidden" asp-for="PreferenciaContacto" id="PreferenciaContacto" />

        <div class="location-card">
            <div class="thumb"><i class="fas fa-house" style="color:#0066CC;"></i></div>
            <div class="meta">
                <div class="addr"><input asp-for="DireccionPropiedad" placeholder="@L["Service address"]" required style="border:none;background:transparent;width:100%;font-family:inherit;font-weight:600;font-size:0.88rem;" /></div>
                <div class="sub">@L["Move-in setup"]</div>
            </div>
            <span style="color:#0066CC;font-weight:600;font-size:0.85rem;"><i class="fas fa-pen"></i> @L["Edit"]</span>
        </div>
        <span asp-validation-for="DireccionPropiedad" style="color:#B91C1C;font-size:0.82rem;display:block;margin:-8px 0 12px;"></span>

        <div class="field-card" data-svc-required="ServiciosConectar">
            <span class="field-label">@L["What do you need to connect?"]</span>
            <div class="service-grid" id="servicesGroup">
                <button type="button" class="service-tile" data-value="Internet"><span class="check"><i class="fas fa-check"></i></span><i class="fas fa-wifi"></i>@L["Internet"]</button>
                <button type="button" class="service-tile" data-value="Cable"><span class="check"><i class="fas fa-check"></i></span><i class="fas fa-tv"></i>@L["Cable"]</button>
                <button type="button" class="service-tile" data-value="Electricity"><span class="check"><i class="fas fa-check"></i></span><i class="fas fa-bolt"></i>@L["Electricity"]</button>
                <button type="button" class="service-tile" data-value="Water"><span class="check"><i class="fas fa-check"></i></span><i class="fas fa-droplet"></i>@L["Water"]</button>
                <button type="button" class="service-tile" data-value="Gas"><span class="check"><i class="fas fa-check"></i></span><i class="fas fa-fire-flame-simple"></i>@L["Gas"]</button>
            </div>
        </div>

        <div class="field-card" data-svc-required="FechaServicio">
            <span class="field-label">@L["When do you need service?"]</span>
            <div class="input-wrap">
                <i class="fas fa-calendar"></i>
                <input asp-for="FechaServicio" id="FechaServicio" type="date" value="@fechaValue" min="@fechaMin" required />
            </div>
        </div>

        <div class="field-card" data-svc-required="PreferenciaContacto">
            <span class="field-label">@L["Contact preference"]</span>
            <div class="pref-row" id="prefGroup">
                <button type="button" class="pref-btn" data-value="ContactMyself"><i class="fas fa-user"></i>@L["I'll contact providers myself"]</button>
                <button type="button" class="pref-btn" data-value="SaveForLater"><i class="fas fa-clock"></i>@L["Save providers for later"]</button>
            </div>
        </div>

        <div class="info-box-blue"><i class="fas fa-circle-info"></i><span>@L["We'll show the providers that serve this address, plus phone numbers and websites so you can connect service faster."]</span></div>

        <button type="submit" name="action" value="continue" class="btn-primary">@L["Continue"]</button>
        <button type="submit" name="action" value="skip" class="btn-outline" formnovalidate>@L["Skip for now"]</button>
    </form>
</div>
@section Scripts {
<script>
    (function () {
        function initMulti(groupId, hiddenId, initial) {
            const hidden = document.getElementById(hiddenId);
            const selected = new Set((initial || hidden.value || '').split('|').filter(Boolean));
            document.querySelectorAll('#' + groupId + ' .service-tile').forEach(btn => {
                if (selected.has(btn.dataset.value)) btn.classList.add('active');
                btn.addEventListener('click', () => {
                    const value = btn.dataset.value;
                    if (selected.has(value)) { selected.delete(value); btn.classList.remove('active'); }
                    else { selected.add(value); btn.classList.add('active'); }
                    hidden.value = Array.from(selected).join('|');
                });
            });
            hidden.value = Array.from(selected).join('|');
        }

        function initSingle(groupId, hiddenId, initial) {
            const hidden = document.getElementById(hiddenId);
            document.querySelectorAll('#' + groupId + ' .pref-btn').forEach(btn => {
                if (btn.dataset.value === (initial || hidden.value)) btn.classList.add('active');
                btn.addEventListener('click', () => {
                    document.querySelectorAll('#' + groupId + ' .pref-btn').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    hidden.value = btn.dataset.value;
                });
            });
        }

        initMulti('servicesGroup', 'ServiciosConectar', '@Model.ServiciosConectar');
        initSingle('prefGroup', 'PreferenciaContacto', '@Model.PreferenciaContacto');

        const fechaInput = document.getElementById('FechaServicio');
        const pastDateMessage = @Json.Serialize(L["Please select today or a future date."]);
        if (fechaInput) {
            fechaInput.min = '@fechaMin';
            if (fechaInput.value && fechaInput.value < fechaInput.min) {
                fechaInput.value = '';
            }
        }

        document.querySelector('form')?.addEventListener('submit', function (e) {
            if (e.submitter && (e.submitter.value === 'skip' || e.submitter.getAttribute('formnovalidate') != null)) {
                return;
            }
            if (!fechaInput) return;
            if (fechaInput.value && fechaInput.min && fechaInput.value < fechaInput.min) {
                e.preventDefault();
                e.stopPropagation();
                fechaInput.value = '';
                const card = fechaInput.closest('.field-card');
                if (card) {
                    card.classList.add('is-invalid');
                    let msg = card.querySelector('[data-svc-error="true"]');
                    if (!msg) {
                        msg = document.createElement('div');
                        msg.className = 'field-inline-error';
                        msg.setAttribute('data-svc-error', 'true');
                        msg.setAttribute('role', 'alert');
                        card.appendChild(msg);
                    }
                    msg.textContent = pastDateMessage;
                    card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }
        }, true);
    })();

</script>
}
