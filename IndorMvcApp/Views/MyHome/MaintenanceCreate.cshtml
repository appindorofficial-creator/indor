@using System.Text.Json
@model IndorMvcApp.ViewModels.MyHomeMaintenanceFormViewModel
@{
    ViewData["Title"] = L["Add Maintenance"];
    Layout = "~/Views/Shared/_MyHomeLayout.cshtml";
    ViewBag.PropiedadId = Model.PropiedadId;
    ViewBag.MyHomeNav = "maintenance";
    ViewBag.MyHomeBackUrl = Url.Action("Maintenance", "MyHome", new { id = Model.PropiedadId, from = Model.NavigationFrom });
    var hasServerErrors = !ViewData.ModelState.IsValid;
}
@section Head {
    <style>
        .hf-validation-summary { background:#FEF2F2; border:1px solid #FECACA; color:#B91C1C; border-radius:12px; padding:12px 14px; margin-bottom:14px; font-size:0.86rem; line-height:1.45; }
        .hf-validation-summary ul { margin:0; padding-left:18px; }
        .hf-validation-summary.validation-summary-valid { display:none; }
        .hf-field-error { display:block; color:#B91C1C; font-size:0.82rem; font-weight:600; margin:-6px 0 12px; }
        .hf-field-error:empty { display:none; }
        .hf-input.is-invalid,
        .hf-textarea.is-invalid { border-color:#DC2626 !important; box-shadow:0 0 0 3px rgba(220,38,38,0.12); }
        .hf-label.is-invalid-label { color:#B91C1C; }
    </style>
}
<div class="hf-title-row">
    <h1 class="hf-title">@L["Add maintenance"]</h1>
</div>
<form asp-controller="MyHome" asp-action="MaintenanceCreate" asp-route-id="@Model.PropiedadId" method="post" class="hf-maint-form" id="maintenanceCreateForm" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="PropiedadId" />
    <input type="hidden" asp-for="NavigationFrom" />
    <input type="hidden" asp-for="Status" value="Upcoming" />

    <div asp-validation-summary="All" class="hf-validation-summary" id="maintServerErrors"></div>
    <div class="hf-validation-summary" id="maintClientErrors" hidden role="alert"></div>

    <label asp-for="Title" class="hf-label" id="titleLabel">@L["Task title"]</label>
    <input asp-for="Title" class="hf-input" id="Title" required maxlength="150" placeholder="@L["Check AC system"]" aria-describedby="titleError" />
    <span asp-validation-for="Title" class="hf-field-error" id="titleError"></span>

    <label asp-for="DueDate" class="hf-label" id="dueDateLabel">@L["Due date"]</label>
    <input asp-for="DueDate" class="hf-input" id="DueDate" type="date" required aria-describedby="dueDateError" />
    <span asp-validation-for="DueDate" class="hf-field-error" id="dueDateError"></span>

    <p class="hf-label" style="margin-top:16px;">@L["How would you like to handle this?"]</p>
    <div class="hf-help-mode">
        <label class="hf-help-mode-card">
            <input type="radio" name="SaveModeChoice" value="Agenda" checked data-save-mode />
            <span class="hf-help-mode-icon"><i class="fas fa-calendar-check"></i></span>
            <strong>@L["Save to my agenda"]</strong>
            <small>@L["Add a reminder with your message. INDOR will not search for a contractor."]</small>
        </label>
        <label class="hf-help-mode-card">
            <input type="radio" name="SaveModeChoice" value="IndorSpecialist" data-save-mode />
            <span class="hf-help-mode-icon hf-help-mode-icon--indor"><i class="fas fa-user-shield"></i></span>
            <strong>@L["Request Indor specialist"]</strong>
            <small>@L["INDOR will receive your request and find a verified contractor for you."]</small>
        </label>
    </div>
    <input type="hidden" name="SaveMode" id="SaveMode" value="Agenda" />

    <label asp-for="Notes" class="hf-label">@L["Leave a message"]</label>
    <textarea asp-for="Notes" class="hf-textarea" rows="3" placeholder="@L["Optional notes about this task..."]"></textarea>

    <div class="hf-maint-actions">
        <button type="submit" class="hf-btn hf-btn-outline" data-submit-mode="Agenda">
            <i class="fas fa-calendar-plus"></i> @L["Save to agenda"]
        </button>
        <button type="submit" class="hf-btn hf-btn-primary" data-submit-mode="IndorSpecialist">
            <i class="fas fa-user-shield"></i> @L["Request Indor specialist"]
        </button>
    </div>
    <p class="hf-maint-hint"><i class="fas fa-circle-info"></i> @L["Tap the shield icon on any task to request an Indor specialist."]</p>
</form>

<style>
    .hf-help-mode { display: grid; gap: 10px; margin-bottom: 16px; }
    .hf-help-mode-card {
        display: grid;
        grid-template-columns: auto 1fr;
        grid-template-rows: auto auto;
        gap: 2px 12px;
        padding: 14px;
        border: 2px solid #E2E8F0;
        border-radius: 14px;
        cursor: pointer;
        background: #fff;
    }
    .hf-help-mode-card:has(input:checked) { border-color: #0066CC; background: rgba(0,102,204,0.04); }
    .hf-help-mode-card input { grid-row: 1 / span 2; align-self: center; accent-color: #0066CC; }
    .hf-help-mode-icon {
        grid-column: 2;
        width: 36px; height: 36px; border-radius: 10px;
        background: rgba(0,102,204,0.1); color: #0066CC;
        display: flex; align-items: center; justify-content: center;
    }
    .hf-help-mode-icon--indor { background: rgba(16,185,129,0.12); color: #059669; }
    .hf-help-mode-card strong { grid-column: 2; font-size: 0.95rem; }
    .hf-help-mode-card small { grid-column: 2; color: #64748B; line-height: 1.4; }
    .hf-maint-actions { display: grid; gap: 10px; margin-top: 8px; }
    .hf-maint-actions .hf-btn { width: 100%; justify-content: center; }
    .hf-maint-hint { font-size: 0.82rem; color: #64748B; margin-top: 12px; line-height: 1.4; }
    .hf-maint-hint i { color: #0066CC; margin-right: 4px; }
</style>

@section Scripts {
<script>
    (function () {
        var form = document.getElementById('maintenanceCreateForm');
        if (!form) { return; }

        var msgs = {
            summary: @Html.Raw(JsonSerializer.Serialize(L["Please complete the highlighted fields to continue."].ToString())),
            title: @Html.Raw(JsonSerializer.Serialize(L["Please enter a task title."].ToString())),
            dueDate: @Html.Raw(JsonSerializer.Serialize(L["Please select a due date."].ToString()))
        };

        var titleInput = document.getElementById('Title');
        var dueDateInput = document.getElementById('DueDate');
        var titleError = document.getElementById('titleError');
        var dueDateError = document.getElementById('dueDateError');
        var titleLabel = document.getElementById('titleLabel');
        var dueDateLabel = document.getElementById('dueDateLabel');
        var clientErrors = document.getElementById('maintClientErrors');
        var saveModeInput = document.getElementById('SaveMode');
        var pendingMode = null;

        function setSaveMode(mode) {
            if (!saveModeInput) { return; }
            saveModeInput.value = mode;
            form.querySelectorAll('[data-save-mode]').forEach(function (radio) {
                radio.checked = radio.value === mode;
            });
        }

        form.querySelectorAll('[data-save-mode]').forEach(function (radio) {
            radio.addEventListener('change', function () {
                if (radio.checked) {
                    setSaveMode(radio.value);
                }
            });
        });

        form.querySelectorAll('[data-submit-mode]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                pendingMode = btn.getAttribute('data-submit-mode') || 'Agenda';
                setSaveMode(pendingMode);
            });
        });

        function clearField(input, errorEl, label) {
            if (input) { input.classList.remove('is-invalid'); }
            if (label) { label.classList.remove('is-invalid-label'); }
            if (errorEl && !errorEl.getAttribute('data-server')) {
                errorEl.textContent = '';
            }
        }

        function markField(input, errorEl, label, message) {
            if (input) { input.classList.add('is-invalid'); }
            if (label) { label.classList.add('is-invalid-label'); }
            if (errorEl) { errorEl.textContent = message; }
        }

        function validate() {
            var missing = [];
            clearField(titleInput, titleError, titleLabel);
            clearField(dueDateInput, dueDateError, dueDateLabel);

            var titleOk = titleInput && titleInput.value.trim().length > 0;
            var dueOk = dueDateInput && dueDateInput.value.trim().length > 0;

            if (!titleOk) {
                markField(titleInput, titleError, titleLabel, msgs.title);
                missing.push(msgs.title);
            }
            if (!dueOk) {
                markField(dueDateInput, dueDateError, dueDateLabel, msgs.dueDate);
                missing.push(msgs.dueDate);
            }

            if (clientErrors) {
                if (missing.length) {
                    clientErrors.hidden = false;
                    clientErrors.innerHTML = '<strong>' + msgs.summary + '</strong><ul>' +
                        missing.map(function (m) { return '<li>' + m + '</li>'; }).join('') +
                        '</ul>';
                } else {
                    clientErrors.hidden = true;
                    clientErrors.innerHTML = '';
                }
            }

            return missing.length === 0;
        }

        form.addEventListener('submit', function (e) {
            if (pendingMode) {
                setSaveMode(pendingMode);
            }

            if (!validate()) {
                e.preventDefault();
                var firstInvalid = form.querySelector('.hf-input.is-invalid');
                if (firstInvalid && typeof firstInvalid.focus === 'function') {
                    firstInvalid.focus({ preventScroll: false });
                    firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
                if (clientErrors) {
                    clientErrors.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }
                return;
            }

            setTimeout(function () {
                form.querySelectorAll('button[type="submit"]').forEach(function (btn) {
                    btn.disabled = true;
                    btn.style.opacity = '0.7';
                });
            }, 0);
        });

        [titleInput, dueDateInput].forEach(function (field) {
            if (!field) { return; }
            field.addEventListener('input', function () { validate(); });
            field.addEventListener('change', function () { validate(); });
        });

        @if (hasServerErrors)
        {
            <text>
            if (titleInput && !titleInput.value.trim()) {
                titleInput.classList.add('is-invalid');
                if (titleLabel) titleLabel.classList.add('is-invalid-label');
            }
            if (dueDateInput && !dueDateInput.value.trim()) {
                dueDateInput.classList.add('is-invalid');
                if (dueDateLabel) dueDateLabel.classList.add('is-invalid-label');
            }
            </text>
        }
    })();
</script>
}
