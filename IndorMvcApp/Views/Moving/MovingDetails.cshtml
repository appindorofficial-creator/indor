@model IndorMvcApp.ViewModels.MovingDetailsViewModel
@{
    ViewData["Title"] = L.Catalog(Model.PageTitle) + " - INDOR";
    ViewData["WizardTitle"] = L.Catalog(Model.PageTitle);
    ViewData["WizardStep"] = 1;
    ViewData["WizardTotalSteps"] = 3;
    ViewData["WizardBackUrl"] = Url.Action("MovingService", "Moving", new { id = Model.MovingSetupServicioId });
    var fechaValue = Model.FechaMovimiento?.ToString("yyyy-MM-dd") ?? string.Empty;
    var fechaMin = DateTime.Today.ToString("yyyy-MM-dd");
    var addressHint = L["Enter a complete address with city and state (e.g. 123 Main St, Charlotte, NC)."].ToString();
}

<div class="cl-wizard-heading">
    <h2>@L["Tell us about your move"]</h2>
</div>

<div asp-validation-summary="ModelOnly" class="validation-summary"></div>

<form asp-action="MovingDetails" method="post" novalidate id="movingDetailsForm" class="iw-step-form">
    <input type="hidden" asp-for="SolicitudId" />
    <input type="hidden" asp-for="MovingSetupServicioId" />
    <input type="hidden" asp-for="NombreServicio" />
    <input type="hidden" asp-for="TipoMovimiento" id="TipoMovimiento" />
    <input type="hidden" asp-for="TipoPropiedad" id="TipoPropiedad" />
    <input type="hidden" asp-for="TamanoHogar" id="TamanoHogar" />
    <input type="hidden" asp-for="TipoServicio" id="TipoServicio" />
    <input type="hidden" asp-for="VentanaHorario" id="VentanaHorario" />
    <input type="hidden" asp-for="FechaMovimiento" id="FechaMovimiento" value="@fechaValue" />

    <div class="field-card" data-svc-required="TipoMovimiento">
        <span class="field-label">@L["Move type"]</span>
        <div class="tile-grid" data-target="TipoMovimiento">
            <button type="button" class="tile-btn" data-value="MoveIn"><i class="fas fa-house-circle-check"></i>@L["Move-In"]</button>
            <button type="button" class="tile-btn" data-value="MoveOut"><i class="fas fa-house-circle-xmark"></i>@L["Move-Out"]</button>
            <button type="button" class="tile-btn" data-value="FullMove"><i class="fas fa-truck-moving"></i>@L["Full Move"]</button>
        </div>
        <span asp-validation-for="TipoMovimiento"></span>
    </div>

    <div class="field-card" data-svc-required="TipoPropiedad">
        <span class="field-label">@L["Property type"]</span>
        <div class="tile-grid tile-grid-4" data-target="TipoPropiedad">
            <button type="button" class="tile-btn" data-value="Apartment"><i class="fas fa-building"></i>@L["Apartment"]</button>
            <button type="button" class="tile-btn" data-value="House"><i class="fas fa-house"></i>@L["House"]</button>
            <button type="button" class="tile-btn" data-value="Condo"><i class="fas fa-city"></i>@L["Condo"]</button>
            <button type="button" class="tile-btn" data-value="Townhome"><i class="fas fa-house-chimney"></i>@L["Townhome"]</button>
        </div>
        <span asp-validation-for="TipoPropiedad"></span>
    </div>

    <div class="field-card" data-svc-required="TamanoHogar">
        <span class="field-label">@L["Home size"]</span>
        <div class="tile-grid" data-target="TamanoHogar">
            <button type="button" class="tile-btn" data-value="Studio"><i class="fas fa-bed"></i>@L["Studio"]</button>
            <button type="button" class="tile-btn" data-value="OneTwoBedrooms"><i class="fas fa-door-open"></i>@L["1-2 Bedrooms"]</button>
            <button type="button" class="tile-btn" data-value="ThreePlusBedrooms"><i class="fas fa-house-user"></i>@L["3+ Bedrooms"]</button>
        </div>
        <span asp-validation-for="TamanoHogar"></span>
    </div>

    <div class="field-card" data-svc-required="DireccionOrigen" data-svc-address>
        <span class="field-label">@L["From"]</span>
        <div class="input-wrap">
            <i class="fas fa-location-dot"></i>
            <input asp-for="DireccionOrigen" id="DireccionOrigen" placeholder="@L["Pick up address"]" data-address-autocomplete autocomplete="off" />
        </div>
        <p class="field-hint">@addressHint</p>
        <span asp-validation-for="DireccionOrigen"></span>
    </div>

    <div class="field-card" data-svc-required="DireccionDestino" data-svc-address>
        <span class="field-label">@L["To"]</span>
        <div class="input-wrap">
            <i class="fas fa-location-dot"></i>
            <input asp-for="DireccionDestino" id="DireccionDestino" placeholder="@L["Drop off address"]" data-address-autocomplete autocomplete="off" />
        </div>
        <p class="field-hint">@addressHint</p>
        <span asp-validation-for="DireccionDestino"></span>
    </div>

    <div class="field-card" data-svc-required="FechaMovimiento">
        <span class="field-label">@L["Move date"]</span>
        <div class="input-wrap">
            <i class="fas fa-calendar"></i>
            <input type="date" id="FechaMovimientoInput" value="@fechaValue" min="@fechaMin" />
        </div>
        <span asp-validation-for="FechaMovimiento"></span>
    </div>

    <div class="field-card" data-svc-required="VentanaHorario">
        <span class="field-label">@L["Preferred arrival time"]</span>
        <div class="input-wrap">
            <i class="fas fa-clock"></i>
            <select id="VentanaHorarioSelect">
                <option value="">@L["Select a time"]</option>
                <option value="Morning">@L["9:00 AM – 11:00 AM"]</option>
                <option value="MidMorning">@L["11:00 AM – 1:00 PM"]</option>
                <option value="Afternoon">@L["2:00 PM – 4:00 PM"]</option>
                <option value="Evening">@L["4:00 PM – 6:00 PM"]</option>
            </select>
        </div>
        <span asp-validation-for="VentanaHorario"></span>
    </div>

    <div class="field-card" data-svc-required="TipoServicio">
        <span class="field-label">@L["Service type"]</span>
        <div class="service-block" data-target="TipoServicio" data-value="MoversOnly">
            <strong>@L["Movers only"]</strong>
            <span>@L["You provide the truck."]</span>
        </div>
        <div class="service-block" data-target="TipoServicio" data-value="TruckAndMovers">
            <strong>@L["Truck + Movers"]</strong>
            <span>@L["We bring the truck."]</span>
        </div>
        <span asp-validation-for="TipoServicio"></span>
    </div>

    <div class="cl-form-actions">
        <button type="submit" class="btn-primary">@L["Continue"] <i class="fas fa-chevron-right"></i></button>
        <button type="submit" name="action" value="back" class="btn-outline" formnovalidate>@L["Back"]</button>
    </div>
</form>

@section Scripts {
<script>
    (function () {
        function initTiles(containerSelector, hiddenId, initial) {
            const hidden = document.getElementById(hiddenId);
            const container = document.querySelector(containerSelector);
            if (!container || !hidden) return;
            const buttons = container.querySelectorAll('.tile-btn');
            const seed = (initial && String(initial).trim()) || (hidden.value || '').trim();
            function setActive(value) {
                hidden.value = value || '';
                buttons.forEach(b => b.classList.toggle('active', !!value && b.dataset.value === value));
            }
            buttons.forEach(btn => btn.addEventListener('click', () => setActive(btn.dataset.value)));
            setActive(seed);
        }

        initTiles('[data-target="TipoMovimiento"]', 'TipoMovimiento', '@Model.TipoMovimiento');
        initTiles('[data-target="TipoPropiedad"]', 'TipoPropiedad', '@Model.TipoPropiedad');
        initTiles('[data-target="TamanoHogar"]', 'TamanoHogar', '@Model.TamanoHogar');

        const serviceHidden = document.getElementById('TipoServicio');
        const serviceBlocks = document.querySelectorAll('.service-block');
        function setServiceType(value) {
            if (!serviceHidden) return;
            serviceHidden.value = value || '';
            serviceBlocks.forEach(b => b.classList.toggle('active', !!serviceHidden.value && b.dataset.value === serviceHidden.value));
        }
        serviceBlocks.forEach(block => {
            block.addEventListener('click', () => setServiceType(block.dataset.value));
        });
        setServiceType(serviceHidden?.value || '');

        const timeHidden = document.getElementById('VentanaHorario');
        const timeSelect = document.getElementById('VentanaHorarioSelect');
        if (timeHidden && timeSelect) {
            timeSelect.value = timeHidden.value || '';
            timeSelect.addEventListener('change', () => { timeHidden.value = timeSelect.value; });
        }

        const fechaHidden = document.getElementById('FechaMovimiento');
        const fechaInput = document.getElementById('FechaMovimientoInput');
        if (fechaHidden && fechaInput) {
            fechaInput.addEventListener('change', () => { fechaHidden.value = fechaInput.value || ''; });
            fechaInput.addEventListener('input', () => { fechaHidden.value = fechaInput.value || ''; });
        }

        const addressMessage = @Json.Serialize(addressHint);
        const pastDateMessage = @Json.Serialize(L["Please select today or a future date."]);

        function isValidStreetAddress(value) {
            const address = String(value || '').trim();
            if (address.length < 5) return false;
            if (!/\p{L}/u.test(address)) return false;
            if (/^[\d\s.,#-]+$/.test(address)) return false;
            const tokens = address.split(/\s+/).filter(Boolean);
            const hasDigit = /\d/.test(address);
            const wordParts = tokens.filter(part => /\p{L}/u.test(part)).length;
            if (!hasDigit || wordParts < 2) return false;
            const hasComma = address.includes(',');
            const hasZip = tokens.slice(1).some(t => /^\d{5}(-\d{4})?$/.test(t.replace(/[.,]+$/, '')));
            return hasComma || hasZip;
        }

        function showInline(card, message) {
            if (!card) return;
            card.classList.add('is-invalid');
            const existing = card.querySelector('[data-svc-error="true"]');
            if (existing) {
                existing.textContent = message;
                return;
            }
            const msg = document.createElement('div');
            msg.className = 'field-inline-error';
            msg.setAttribute('data-svc-error', 'true');
            msg.setAttribute('role', 'alert');
            msg.textContent = message;
            card.appendChild(msg);
        }

        if (fechaHidden && fechaInput) {
            fechaInput.min = '@fechaMin';
            if (fechaInput.value && fechaInput.value < fechaInput.min) {
                fechaInput.value = '';
                fechaHidden.value = '';
            }
        }

        document.getElementById('movingDetailsForm')?.addEventListener('submit', function (e) {
            if (e.submitter && (e.submitter.value === 'back' || e.submitter.getAttribute('formnovalidate') != null)) {
                return;
            }

            let firstInvalid = null;
            [['DireccionOrigen', 'DireccionOrigen'], ['DireccionDestino', 'DireccionDestino']].forEach(function (pair) {
                const input = document.getElementById(pair[0]);
                const card = input?.closest('.field-card');
                if (!input || !card) return;
                const value = String(input.value || '').trim();
                if (!value) {
                    showInline(card, addressMessage);
                    if (!firstInvalid) firstInvalid = card;
                    return;
                }
                if (isValidStreetAddress(value)) return;
                showInline(card, addressMessage);
                if (!firstInvalid) firstInvalid = card;
            });

            if (fechaInput && fechaHidden) {
                const card = fechaInput.closest('.field-card');
                const value = fechaInput.value || fechaHidden.value || '';
                if (value && fechaInput.min && value < fechaInput.min) {
                    fechaHidden.value = '';
                    fechaInput.value = '';
                    showInline(card, pastDateMessage);
                    if (!firstInvalid) firstInvalid = card;
                }
            }

            if (firstInvalid) {
                e.preventDefault();
                e.stopPropagation();
                if (typeof window.indorHideNavigationLoading === 'function') {
                    window.indorHideNavigationLoading();
                }
                firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }, true);
    })();
</script>
@await Html.PartialAsync("_AddressAutocompleteScripts")
}
