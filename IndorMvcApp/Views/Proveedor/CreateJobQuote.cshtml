@model IndorMvcApp.ViewModels.ProviderProCreateJobQuoteViewModel
@{
    ViewData["Title"] = L["Create Job - INDOR PRO"];
    Layout = "_ProviderProLayout";
    var charCount = Model.QuoteRequestNotes?.Length ?? 0;
}

<div class="prv-pro-shell prv-pro-shell--create-job prv-pro-shell--wizard">
    @await Html.PartialAsync("_ProviderProTopbar", Model.CompanyName)

    @{
        ViewBag.WizardStepLine = Model.StepSubtitle;
        ViewBag.WizardSteps = Model.WizardSteps;
    }
    @await Html.PartialAsync("_CreateJobWizardHead")

    <section class="prv-pro-wizard-summary">
        <div>
            <small>@L["Job type"]</small>
            <span class="prv-pro-wizard-type-icon prv-pro-wizard-type-icon--@Model.ServiceCategoryTone">
                <i class="fas @Model.ServiceCategoryIcon"></i>
            </span>
            <strong>@UiDisplayLocalization.Localize(L, Model.ServiceCategoryLabel)</strong>
        </div>
        <div>
            <small>@L["Customer"]</small>
            <span class="prv-pro-customer-avatar prv-pro-customer-avatar--@Model.CustomerTone">@Model.CustomerInitials</span>
            <strong>@Model.CustomerName</strong>
        </div>
    </section>

    <form asp-controller="Proveedor" asp-action="CreateJobQuote" method="post" class="prv-pro-wizard-form" id="createJobQuoteForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="SendQuote" id="createJobSendQuote" value="@(Model.SendQuote ? "true" : "false")" />
        <input type="hidden" name="SubmitAction" id="createJobQuoteAction" value="ai" />
        <input type="hidden" name="HasVoiceRecording" id="createJobHasVoice" value="@(Model.HasVoiceRecording ? "true" : "false")" />

        <section class="prv-pro-wizard-card">
            <h2>@L["Would you like to send a quote from INDOR?"]</h2>
            <p>@L["You can write the request or record audio. INDOR's AI agent will use it to help build a detailed estimate."]</p>

            <div class="prv-pro-quote-toggle">
                <button type="button" class="prv-pro-quote-toggle-btn @(Model.SendQuote ? "is-active" : "")" data-send="true">
                    <i class="fas fa-paper-plane"></i> @L["Yes, send quote"]</button>
                <button type="button" class="prv-pro-quote-toggle-btn @(!Model.SendQuote ? "is-active" : "")" data-send="false">
                    @L["Skip for now"]
                </button>
            </div>
        </section>

        <section class="prv-pro-wizard-card prv-pro-quote-inputs @(Model.SendQuote ? "" : "is-hidden")" id="createJobQuoteInputs">
            <label class="prv-pro-form-label">
                @L["Describe what needs to be done"]
                <textarea name="QuoteRequestNotes" id="createJobQuoteNotes" rows="5" maxlength="@Model.MaxCharacters" placeholder="@L["Describe the work, damage, and what the customer needs..."]">@Model.QuoteRequestNotes</textarea>
            </label>
            <div class="prv-pro-quote-charcount"><span id="createJobQuoteCount">@charCount</span> / @Model.MaxCharacters</div>

            <div class="prv-pro-quote-audio @(Model.HasVoiceRecording ? "is-recorded" : "")"
                 id="createJobQuoteAudio"
                 data-label-record="@L["Record audio"]"
                 data-label-stop="@L["Stop recording"]"
                 data-label-recorded="@L["Audio recorded"]"
                 data-label-play="@L["Play recording"]"
                 data-label-pause="@L["Pause recording"]"
                 data-label-delete="@L["Delete recording"]"
                 data-label-transcribing="@L["Transcribing…"]"
                 data-label-no-transcript="@L["Could not transcribe this recording."]"
                 data-speech-lang="@(L.IsSpanish ? "es-US" : "en-US")"
                 data-msg-mic-denied="@L["Microphone permission is required to record audio."]"
                 data-msg-mic-unavailable="@L["Microphone is not available in this browser."]">
                <button type="button" class="prv-pro-quote-mic" id="createJobQuoteMic" title="@L["Record audio"]" aria-pressed="false">
                    <i class="fas fa-microphone"></i>
                </button>
                <div class="prv-pro-quote-audio-body">
                    <button type="button" class="prv-pro-quote-record-btn" id="createJobQuoteRecord">
                        @(Model.HasVoiceRecording ? L["Audio recorded"] : L["Record audio"])
                    </button>
                    <div class="prv-pro-quote-audio-meter">
                        <div class="prv-pro-quote-wave @(Model.HasVoiceRecording ? "is-recorded" : "")" id="createJobQuoteWave" aria-hidden="true">
                            @for (var i = 0; i < 18; i++) { <span></span> }
                        </div>
                        <small id="createJobQuoteTimer">00:00</small>
                    </div>
                    <audio id="createJobQuotePlayer" class="prv-pro-quote-player" preload="metadata" playsinline></audio>
                    <div class="prv-pro-quote-audio-actions" id="createJobQuoteAudioActions">
                        <button type="button" class="prv-pro-quote-audio-text-btn" id="createJobQuotePlay">
                            <i class="fas fa-play"></i>
                            <span>@L["Play recording"]</span>
                        </button>
                        <button type="button" class="prv-pro-quote-audio-text-btn prv-pro-quote-audio-text-btn--danger" id="createJobQuoteDelete">
                            <i class="fas fa-trash"></i>
                            <span>@L["Delete recording"]</span>
                        </button>
                    </div>
                </div>
            </div>
            <p class="prv-pro-quote-audio-error is-hidden" id="createJobQuoteAudioError" role="alert"></p>
            <small class="prv-pro-wizard-hint">@L["AI will transcribe audio automatically"]</small>
            <input type="hidden" name="VoiceTranscript" id="createJobVoiceTranscript" value="@Model.VoiceTranscript" />
            <div class="prv-pro-quote-transcript @(string.IsNullOrWhiteSpace(Model.VoiceTranscript) && !Model.HasVoiceRecording ? "is-hidden" : "")"
                 id="createJobQuoteTranscript">
                <strong>@L["Voice transcript"]</strong>
                <p id="createJobQuoteTranscriptText">@(string.IsNullOrWhiteSpace(Model.VoiceTranscript) ? "" : Model.VoiceTranscript)</p>
            </div>

            <div class="prv-pro-quote-attachments">
                <h3>@L["Add photos or inspection notes (optional)"]</h3>
                <div class="prv-pro-quote-attachment-list">
                    @foreach (var file in Model.Attachments)
                    {
                        <div class="prv-pro-quote-attachment" data-id="@file.Id">
                            @if (file.Kind == "image" && !string.IsNullOrWhiteSpace(file.ThumbnailUrl))
                            {
                                <img src="@file.ThumbnailUrl" alt="" />
                            }
                            else
                            {
                                <span class="prv-pro-quote-attachment-doc"><i class="fas fa-file-lines"></i></span>
                            }
                            <div>
                                <strong>@file.Name</strong>
                                <small>@file.SizeLabel</small>
                            </div>
                            <button type="button" class="prv-pro-quote-attachment-remove" title="@L["Remove"]"><i class="fas fa-xmark"></i></button>
                        </div>
                    }
                </div>
            </div>
        </section>

        <div class="prv-pro-wizard-info">
            <i class="fas fa-circle-info"></i>
            <span>@L["INDOR AI will read your notes, audio, and attachments to draft the quote."]</span>
        </div>

        <div class="prv-pro-wizard-actions">
            <a asp-controller="Proveedor" asp-action="CreateJobDetails" class="prv-pro-btn prv-pro-btn--outline">@L["Back"]</a>
            <button type="submit" class="prv-pro-btn prv-pro-btn--primary" id="createJobQuoteSubmit"
                    data-label-send="@L["Send to AI"]" data-label-continue="@L["Continue"]">@L["Send to AI"]</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            var sendInput = document.getElementById('createJobSendQuote');
            var actionInput = document.getElementById('createJobQuoteAction');
            var submitBtn = document.getElementById('createJobQuoteSubmit');
            var inputs = document.getElementById('createJobQuoteInputs');
            var notes = document.getElementById('createJobQuoteNotes');
            var count = document.getElementById('createJobQuoteCount');
            var toggles = document.querySelectorAll('.prv-pro-quote-toggle-btn');
            var audioRoot = document.getElementById('createJobQuoteAudio');
            var micBtn = document.getElementById('createJobQuoteMic');
            var recordBtn = document.getElementById('createJobQuoteRecord');
            var wave = document.getElementById('createJobQuoteWave');
            var timerEl = document.getElementById('createJobQuoteTimer');
            var errorEl = document.getElementById('createJobQuoteAudioError');
            var hasVoiceInput = document.getElementById('createJobHasVoice');
            var actionsEl = document.getElementById('createJobQuoteAudioActions');
            var playBtn = document.getElementById('createJobQuotePlay');
            var deleteBtn = document.getElementById('createJobQuoteDelete');
            var player = document.getElementById('createJobQuotePlayer');
            var transcriptBox = document.getElementById('createJobQuoteTranscript');
            var transcriptText = document.getElementById('createJobQuoteTranscriptText');
            var transcriptInput = document.getElementById('createJobVoiceTranscript');
            var mediaRecorder = null;
            var mediaStream = null;
            var recordedChunks = [];
            var audioUrl = null;
            var speechRec = null;
            var transcriptParts = [];
            var timerId = null;
            var startedAt = 0;
            var recording = false;

            function setSendQuote(enabled) {
                sendInput.value = enabled ? 'true' : 'false';
                actionInput.value = enabled ? 'ai' : 'skip';
                submitBtn.textContent = enabled ? submitBtn.dataset.labelSend : submitBtn.dataset.labelContinue;
                inputs?.classList.toggle('is-hidden', !enabled);
                toggles.forEach(function (btn) {
                    btn.classList.toggle('is-active', btn.dataset.send === (enabled ? 'true' : 'false'));
                });
            }

            toggles.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    setSendQuote(btn.dataset.send === 'true');
                });
            });

            notes?.addEventListener('input', function () {
                if (count) count.textContent = String(notes.value.length);
            });

            document.querySelectorAll('.prv-pro-quote-attachment-remove').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    btn.closest('.prv-pro-quote-attachment')?.remove();
                });
            });

            function fmtTime(ms) {
                var total = Math.floor(ms / 1000);
                var m = String(Math.floor(total / 60)).padStart(2, '0');
                var s = String(total % 60).padStart(2, '0');
                return m + ':' + s;
            }

            function showAudioError(message) {
                if (!errorEl) return;
                errorEl.textContent = message || '';
                errorEl.classList.toggle('is-hidden', !message);
            }

            function hasRecording() {
                return hasVoiceInput && hasVoiceInput.value === 'true';
            }

            function setPlayIcon(playing) {
                if (!playBtn) return;
                var icon = playBtn.querySelector('i');
                if (icon) icon.className = playing ? 'fas fa-pause' : 'fas fa-play';
                var label = audioRoot?.getAttribute(playing ? 'data-label-pause' : 'data-label-play') || (playing ? 'Pause' : 'Play');
                var text = playBtn.querySelector('span');
                if (text) text.textContent = label;
                playBtn.setAttribute('aria-label', label);
                playBtn.setAttribute('title', label);
            }

            function showTranscript(text, pending) {
                if (!transcriptBox || !transcriptText) return;
                transcriptText.textContent = text || '';
                transcriptBox.classList.remove('is-hidden');
                transcriptBox.classList.toggle('is-pending', !!pending);
                transcriptBox.classList.toggle('is-empty', !pending && !text);
                if (transcriptInput && !pending) transcriptInput.value = text || '';
            }

            function hideTranscript() {
                if (!transcriptBox || !transcriptText) return;
                transcriptText.textContent = '';
                transcriptBox.classList.add('is-hidden');
                transcriptBox.classList.remove('is-pending');
                transcriptBox.classList.remove('is-empty');
                if (transcriptInput) transcriptInput.value = '';
            }

            function setRecordingUi(isRecording) {
                recording = isRecording;
                var recorded = hasRecording();
                audioRoot?.classList.toggle('is-recording', isRecording);
                audioRoot?.classList.toggle('is-recorded', !isRecording && recorded);
                micBtn?.classList.toggle('is-recording', isRecording);
                micBtn?.setAttribute('aria-pressed', isRecording ? 'true' : 'false');
                if (playBtn) playBtn.disabled = isRecording || !recorded || !player || !player.src;
                if (recordBtn && audioRoot) {
                    recordBtn.textContent = isRecording
                        ? (audioRoot.getAttribute('data-label-stop') || 'Stop recording')
                        : (recorded
                            ? (audioRoot.getAttribute('data-label-recorded') || 'Audio recorded')
                            : (audioRoot.getAttribute('data-label-record') || 'Record audio'));
                }
            }

            function stopTimer() {
                if (timerId) {
                    clearInterval(timerId);
                    timerId = null;
                }
            }

            function startTimer() {
                startedAt = Date.now();
                if (timerEl) timerEl.textContent = '00:00';
                stopTimer();
                timerId = setInterval(function () {
                    if (timerEl) timerEl.textContent = fmtTime(Date.now() - startedAt);
                }, 250);
            }

            function cleanupStream() {
                if (mediaStream) {
                    mediaStream.getTracks().forEach(function (t) { t.stop(); });
                    mediaStream = null;
                }
            }

            function revokeAudioUrl() {
                if (player) {
                    player.pause();
                    player.removeAttribute('src');
                    player.load();
                }
                if (audioUrl) {
                    URL.revokeObjectURL(audioUrl);
                    audioUrl = null;
                }
                setPlayIcon(false);
                if (playBtn) playBtn.disabled = true;
            }

            function attachRecording(blob) {
                revokeAudioUrl();
                if (!blob || blob.size === 0 || !player) return;
                audioUrl = URL.createObjectURL(blob);
                player.src = audioUrl;
                if (playBtn) playBtn.disabled = false;
            }

            function stopSpeech() {
                if (!speechRec) return;
                try {
                    speechRec.onresult = null;
                    speechRec.onerror = null;
                    speechRec.onend = null;
                    speechRec.stop();
                } catch (_) { }
                speechRec = null;
            }

            function startSpeech() {
                stopSpeech();
                transcriptParts = [];
                var Ctor = window.SpeechRecognition || window.webkitSpeechRecognition;
                if (!Ctor) return;
                speechRec = new Ctor();
                speechRec.continuous = true;
                speechRec.interimResults = true;
                speechRec.lang = audioRoot?.getAttribute('data-speech-lang') || 'en-US';
                speechRec.onresult = function (event) {
                    var interim = '';
                    for (var i = event.resultIndex; i < event.results.length; i++) {
                        var piece = event.results[i][0] && event.results[i][0].transcript
                            ? event.results[i][0].transcript
                            : '';
                        if (event.results[i].isFinal) transcriptParts.push(piece);
                        else interim += piece;
                    }
                    var text = (transcriptParts.join(' ') + ' ' + interim).replace(/\s+/g, ' ').trim();
                    if (text) showTranscript(text, true);
                };
                speechRec.onend = function () {
                    if (recording && speechRec) {
                        try { speechRec.start(); } catch (_) { }
                    }
                };
                try { speechRec.start(); } catch (_) { }
            }

            function finalizeTranscript(hasAudio) {
                var finalText = transcriptParts.join(' ').replace(/\s+/g, ' ').trim();
                if (!hasAudio) {
                    showTranscript('', false);
                    return;
                }
                if (finalText) {
                    showTranscript(finalText, false);
                    return;
                }
                var emptyLabel = audioRoot?.getAttribute('data-label-no-transcript')
                    || 'Could not transcribe this recording.';
                showTranscript(emptyLabel, false);
                transcriptBox?.classList.add('is-empty');
                if (transcriptInput) transcriptInput.value = '';
            }

            function deleteRecording() {
                if (recording) stopRecording(true);
                stopSpeech();
                revokeAudioUrl();
                recordedChunks = [];
                transcriptParts = [];
                if (hasVoiceInput) hasVoiceInput.value = 'false';
                if (wave) wave.classList.remove('is-recorded');
                if (timerEl) timerEl.textContent = '00:00';
                hideTranscript();
                setRecordingUi(false);
            }

            function stopRecording(discard) {
                if (mediaRecorder && mediaRecorder.state !== 'inactive') {
                    mediaRecorder._discard = !!discard;
                    mediaRecorder.stop();
                } else {
                    stopSpeech();
                    cleanupStream();
                    stopTimer();
                    setRecordingUi(false);
                }
            }

            async function startRecording() {
                showAudioError('');
                if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia || typeof MediaRecorder === 'undefined') {
                    showAudioError(audioRoot?.getAttribute('data-msg-mic-unavailable') || 'Microphone is not available in this browser.');
                    return;
                }
                try {
                    stopSpeech();
                    revokeAudioUrl();
                    recordedChunks = [];
                    transcriptParts = [];
                    if (hasVoiceInput) hasVoiceInput.value = 'false';
                    if (wave) wave.classList.remove('is-recorded');
                    showTranscript(audioRoot?.getAttribute('data-label-transcribing') || 'Transcribing…', true);
                    if (transcriptBox) transcriptBox.classList.remove('is-empty');
                    mediaStream = await navigator.mediaDevices.getUserMedia({ audio: true });
                    var mime = MediaRecorder.isTypeSupported('audio/webm')
                        ? 'audio/webm'
                        : (MediaRecorder.isTypeSupported('audio/mp4') ? 'audio/mp4' : '');
                    mediaRecorder = mime
                        ? new MediaRecorder(mediaStream, { mimeType: mime })
                        : new MediaRecorder(mediaStream);
                    mediaRecorder.addEventListener('dataavailable', function (e) {
                        if (e.data && e.data.size > 0) recordedChunks.push(e.data);
                    });
                    mediaRecorder.addEventListener('stop', function () {
                        var discard = !!mediaRecorder._discard;
                        stopSpeech();
                        cleanupStream();
                        stopTimer();
                        if (discard) {
                            recordedChunks = [];
                            if (hasVoiceInput) hasVoiceInput.value = 'false';
                            setRecordingUi(false);
                            return;
                        }
                        var hasAudio = recordedChunks.some(function (c) { return c && c.size > 0; });
                        if (hasVoiceInput) hasVoiceInput.value = hasAudio ? 'true' : 'false';
                        if (hasAudio) {
                            var type = (mediaRecorder && mediaRecorder.mimeType) ? mediaRecorder.mimeType : (mime || 'audio/webm');
                            attachRecording(new Blob(recordedChunks, { type: type }));
                            if (wave) wave.classList.add('is-recorded');
                        }
                        setRecordingUi(false);
                        finalizeTranscript(hasAudio);
                    });
                    mediaRecorder.start(250);
                    startSpeech();
                    startTimer();
                    setRecordingUi(true);
                } catch (_) {
                    stopSpeech();
                    cleanupStream();
                    stopTimer();
                    hideTranscript();
                    setRecordingUi(false);
                    showAudioError(audioRoot?.getAttribute('data-msg-mic-denied') || 'Microphone permission is required to record audio.');
                }
            }

            function toggleRecording() {
                if (recording) stopRecording(false);
                else startRecording();
            }

            micBtn?.addEventListener('click', toggleRecording);
            recordBtn?.addEventListener('click', toggleRecording);
            playBtn?.addEventListener('click', function () {
                if (!player || !player.src) return;
                if (player.paused) player.play();
                else player.pause();
            });
            player?.addEventListener('play', function () { setPlayIcon(true); });
            player?.addEventListener('pause', function () { setPlayIcon(false); });
            player?.addEventListener('ended', function () { setPlayIcon(false); });
            deleteBtn?.addEventListener('click', deleteRecording);
            if (playBtn && (!player || !player.getAttribute('src'))) playBtn.disabled = true;
        })();
    </script>
}
