<header class="exr-topbar exr-topbar--with-back">
    <a asp-controller="Proveedor" asp-action="Reports" class="exr-back" aria-label="@L["Back"]">
        <i class="fas fa-chevron-left"></i>
    </a>
    <a asp-controller="Proveedor" asp-action="Dashboard" class="exr-brand" aria-label="@L["INDOR PRO home"]">
        <i class="fas fa-house"></i>
        <span>@L["INDOR"]<strong>@L["PRO"]</strong></span>
    </a>
    <span class="exr-back-spacer" aria-hidden="true"></span>
</header>
