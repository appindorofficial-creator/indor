@{
    var backAction = ViewData["TemplatesBackAction"] as string ?? "Settings";
}
<header class="tpl-topbar">
    <a asp-controller="Proveedor" asp-action="@backAction" class="tpl-back" aria-label="@L["Back"]">
        <i class="fas fa-chevron-left"></i>
    </a>
    <a asp-controller="Proveedor" asp-action="Dashboard" class="tpl-brand" aria-label="@L["INDOR PRO home"]">
        <svg viewBox="0 0 24 24" class="tpl-brand-mark" aria-hidden="true">
            <path d="M12 2l8.66 5v10L12 22 3.34 17V7z" fill="none" stroke="#ffffff" stroke-width="2" stroke-linejoin="round" />
            <circle cx="12" cy="12" r="3" fill="#ffffff" />
        </svg>
        <span>@L["INDOR"]<strong>@L["PRO"]</strong></span>
    </a>
    <span class="tpl-back-spacer" aria-hidden="true"></span>
</header>
